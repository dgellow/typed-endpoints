{
  "name": "@dgellow/typed-endpoints",
  "version": "0.1.0",
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "fmt": {
    "exclude": [
      "**/*.generated.ts"
    ]
  },
  "exclude": [
    "CHANGELOG.md",
    "e2e_tests/bun",
    "e2e_tests/framework-types",
    "e2e_tests/python/.venv",
    "e2e_tests/rust/target",
    "scripts/bun-package.ts",
    "TypeScript",
    "aplas-code"
  ],
  "exports": {
    ".": "./src/mod.ts",
    "./fresh": "./src/integrations/fresh.ts",
    "./bun": "./src/integrations/bun.ts",
    "./fetch": "./src/integrations/fetch.ts",
    "./hono": "./src/integrations/hono.ts",
    "./next": "./src/integrations/next.ts",
    "./sveltekit": "./src/integrations/sveltekit.ts",
    "./astro": "./src/integrations/astro.ts",
    "./nitro": "./src/integrations/nitro.ts",
    "./client": "./src/client/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./contract": "./src/contract/index.ts",
    "./python": "./src/python/index.ts",
    "./rust": "./src/rust/index.ts",
    "./cli": "./src/cli.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts",
      "**/fixtures/**"
    ]
  },
  "tasks": {
    "check": "deno check",
    "lint": "./scripts/lint",
    "test": "./scripts/test"
  },
  "license": "MIT",
  "imports": {
    "@/": "./src/",
    "@asteasolutions/zod-to-openapi": "npm:@asteasolutions/zod-to-openapi@^9.1.0",
    "@fresh/core": "jsr:@fresh/core@^2.3.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "vite": "npm:vite@^8.3.8",
    "zod": "npm:zod@^4.6.7"
  }
}
