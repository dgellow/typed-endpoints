{
  "name": "@dgellow/typed-endpoints",
  "version": "0.1.0",
  "lint": {
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "exclude": [
    "CHANGELOG.md",
    "TypeScript",
    "aplas-code"
  ],
  "exports": {
    ".": "./src/mod.ts",
    "./fresh": "./src/integrations/fresh.ts",
    "./client": "./src/client/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./cli": "./src/cli.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts",
      "**/fixtures/**"
    ]
  },
  "tasks": {
    "check": "deno check",
    "test": "deno test"
  },
  "license": "MIT",
  "imports": {
    "@/": "./src/",
    "@asteasolutions/zod-to-openapi": "npm:@asteasolutions/zod-to-openapi@^9.1.0",
    "@fresh/core": "jsr:@fresh/core@^2.3.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "vite": "npm:vite@^8.3.8",
    "zod": "npm:zod@^4.6.7"
  }
}
