#!/usr/bin/env bash
#
# Run the Rust side (e2e_tests/rust): the axum server built from the
# generated module is checked by rustfmt and clippy, started, and the
# conformance tests that hold for the TypeScript server are run against it.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
project="$root/e2e_tests/rust"

if ! command -v cargo >/dev/null 2>&1; then
  echo "error: cargo is not installed (https://rustup.rs)" >&2
  exit 1
fi
# Deno runs the conformance tests.
source "$root/scripts/pinned"
require_pinned deno

cd "$project"

# What follows is checked with one rustfmt and one clippy: the toolchain
# this crate pins. With another, the result would say nothing about it.
pinned="$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)"
active="$(cargo --version | awk '{print $2}')"
if [ "$active" != "$pinned" ]; then
  echo "error: cargo is $active; e2e_tests/rust/rust-toolchain.toml pins $pinned" >&2
  echo "       (run cargo through rustup, which installs and selects it)" >&2
  exit 1
fi

# The generated module and the hand-written handlers read as Rust does:
# formatted as rustfmt formats (the generated module under both style
# editions, so that it is in any crate), and nothing for clippy to say,
# its pedantic lints included.
cargo fmt --check
for edition in 2021 2024; do
  rustfmt --check --edition "$edition" src/api_generated.rs
done
cargo clippy --locked --quiet --all-targets -- -D warnings -W clippy::pedantic
cargo build --locked --quiet

log="$(mktemp)"
"$project/target/debug/typed-endpoints-rust-e2e" >"$log" 2>&1 &
server=$!
# Stops the server and waits for it: it is not left when the script returns.
stop() {
  kill "$server" 2>/dev/null || true
  wait "$server" 2>/dev/null || true
  rm -f "$log"
}
trap stop EXIT

url=""
for _ in $(seq 1 100); do
  url="$(grep -m1 '^http://' "$log" || true)"
  if [ -n "$url" ]; then
    break
  fi
  if ! kill -0 "$server" 2>/dev/null; then
    echo "error: the server did not start:" >&2
    cat "$log" >&2
    exit 1
  fi
  sleep 0.1
done
if [ -z "$url" ]; then
  echo "error: the server did not say where it listens:" >&2
  cat "$log" >&2
  exit 1
fi

cd "$root"
status=0
AXUM_URL="$url" deno test --allow-read --allow-net --allow-env=AXUM_URL \
  e2e_tests/rust/against_axum.ts "$@" || status=$?

if [ "$status" -ne 0 ]; then
  echo "--- server log ---" >&2
  cat "$log" >&2
fi
exit "$status"
