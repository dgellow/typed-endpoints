#!/usr/bin/env bash
#
# Run the Rust side (e2e_tests/rust): the axum server built from the
# generated module is checked by rustfmt and clippy, started, and the
# conformance tests that hold for the TypeScript server are run against it.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
project="$root/e2e_tests/rust"

if ! command -v cargo >/dev/null 2>&1; then
  echo "error: cargo is not installed (https://rustup.rs)" >&2
  exit 1
fi
# Deno runs the conformance tests.
source "$root/scripts/pinned"
require_pinned deno

cd "$project"

# What follows is checked with one rustfmt and one clippy: the toolchain
# this crate pins. With another, the result would say nothing about it.
pinned="$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)"
active="$(cargo --version | awk '{print $2}')"
if [ "$active" != "$pinned" ]; then
  echo "error: cargo is $active; e2e_tests/rust/rust-toolchain.toml pins $pinned" >&2
  echo "       (run cargo through rustup, which installs and selects it)" >&2
  exit 1
fi

# The generated module and the hand-written handlers read as Rust does:
# formatted as rustfmt formats (the generated module under both style
# editions, so that it is in any crate), and nothing for clippy to say,
# its pedantic lints included.
cargo fmt --check
for edition in 2021 2024; do
  rustfmt --check --edition "$edition" src/api_generated.rs src/client_generated.rs
done
cargo clippy --locked --quiet --all-targets -- -D warnings -W clippy::pedantic
# What only Rust can ask of the module: its unit tests.
cargo test --locked --quiet
cargo build --locked --quiet

log="$(mktemp)"
tslog="$(mktemp)"
"$project/target/debug/typed-endpoints-rust-e2e" >"$log" 2>&1 &
server=$!
tsserver=""
# Stops the servers and waits for them: none is left when the script
# returns.
stop() {
  kill "$server" $tsserver 2>/dev/null || true
  wait "$server" $tsserver 2>/dev/null || true
  rm -f "$log" "$tslog"
}
trap stop EXIT

url=""
for _ in $(seq 1 100); do
  url="$(grep -m1 '^http://' "$log" || true)"
  if [ -n "$url" ]; then
    break
  fi
  if ! kill -0 "$server" 2>/dev/null; then
    echo "error: the server did not start:" >&2
    cat "$log" >&2
    exit 1
  fi
  sleep 0.1
done
if [ -z "$url" ]; then
  echo "error: the server did not say where it listens:" >&2
  cat "$log" >&2
  exit 1
fi

cd "$root"
status=0
AXUM_URL="$url" deno test --allow-read --allow-net --allow-env=AXUM_URL \
  e2e_tests/rust/against_axum.ts "$@" || status=$?

# The generated client against the server it was generated beside, and
# against the fixture's TypeScript handlers.
if [ "$status" -eq 0 ] && [ "$#" -eq 0 ]; then
  (cd "$root" && exec deno run --allow-read --allow-net e2e_tests/conformance/serve_typescript.ts) >"$tslog" 2>&1 &
  tsserver=$!
  tsurl=""
  for _ in $(seq 1 300); do
    tsurl="$(grep -m1 '^http://' "$tslog" || true)"
    if [ -n "$tsurl" ] || ! kill -0 "$tsserver" 2>/dev/null; then
      break
    fi
    sleep 0.1
  done
  if [ -z "$tsurl" ]; then
    echo "error: the TypeScript server did not say where it listens:" >&2
    cat "$tslog" >&2
    exit 1
  fi
  cd "$project"
  echo "rust client -> typescript handlers ($tsurl)"
  API_URL="$tsurl" cargo test --locked --quiet --test client -- --ignored || status=$?
  echo "rust client -> generated axum server ($url)"
  API_URL="$url" cargo test --locked --quiet --test client -- --ignored || status=$?
  cd "$root"
fi

# A 500 says nothing to the client, so it has to be in the log: the suite
# makes one handler fail, and the server reports it with its cause.
if [ "$status" -eq 0 ] && [ "$#" -eq 0 ] &&
  ! grep -q 'a handler failed.*GET /api/echo/{+path}.*the backend is down' "$log"; then
  echo "error: the failure of a handler is not in the server's log" >&2
  status=1
fi

if [ "$status" -ne 0 ]; then
  echo "--- server log ---" >&2
  cat "$log" >&2
fi
exit "$status"
