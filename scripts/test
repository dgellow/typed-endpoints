#!/usr/bin/env bash

set -e

source "$(dirname "$0")/pinned"
require_pinned deno

cmd_run_tests() {
  deno test --allow-read --allow-write --allow-run --allow-net
}

cmd_update_snapshots() {
  deno test --allow-read --allow-write --allow-run --allow-net -- --update
}

error() {
  echo "error: $*" >&2
}

cmd_help() {
  echo "Usage: scripts/test or scripts/test --update"
  echo ""
}

case "${1}" in
  "") cmd_run_tests ;;
  update|--update|-u) cmd_update_snapshots ;;
  help|--help|-h) cmd_help ;;
  *)
    error "Unknown command: $1"
    cmd_help
    exit 1
    ;;
esac
