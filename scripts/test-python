#!/usr/bin/env bash
#
# Run the Python side (e2e_tests/python): the FastAPI application built
# from the generated module is type-checked and started under uv, and the
# conformance tests that hold for the TypeScript server are run against it.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
project="$root/e2e_tests/python"

# uv enforces its own version and the interpreter's (pyproject.toml,
# .python-version) and runs the build of Python it installs itself, not one
# of the machine; Deno runs the conformance tests.
if ! command -v uv >/dev/null 2>&1; then
  echo "error: uv is not installed (https://docs.astral.sh/uv/)" >&2
  exit 1
fi
source "$root/scripts/pinned"
require_pinned deno

cd "$project"
uv sync --frozen --quiet

# The generated module and the hand-written handlers, in strict mode.
uv run --frozen pyright

# What the generated router does with a handler that breaks its types.
uv run --frozen python -m unittest --quiet test_runtime

# Where the generated client finds the next page, for every pagination style.
uv run --frozen python -m unittest --quiet test_pagination

# A free port, then the application on it.
port="$(uv run --frozen python -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
log="$(mktemp)"
tslog="$(mktemp)"
uv run --frozen uvicorn app:app --host 127.0.0.1 --port "$port" --log-level warning >"$log" 2>&1 &
server=$!
tsserver=""
trap 'kill "$server" $tsserver 2>/dev/null || true; rm -f "$log" "$tslog"' EXIT

url="http://127.0.0.1:$port"
for _ in $(seq 1 100); do
  if curl --silent --output /dev/null "$url/api/notes"; then
    break
  fi
  if ! kill -0 "$server" 2>/dev/null; then
    echo "error: the application did not start:" >&2
    cat "$log" >&2
    exit 1
  fi
  sleep 0.1
done

# The fixture's TypeScript handlers, for the Python client.
(cd "$root" && exec deno run --allow-read --allow-net e2e_tests/conformance/serve_typescript.ts) >"$tslog" 2>&1 &
tsserver=$!
tsurl=""
for _ in $(seq 1 300); do
  tsurl="$(grep -m1 '^http://' "$tslog" || true)"
  if [ -n "$tsurl" ]; then
    break
  fi
  if ! kill -0 "$tsserver" 2>/dev/null; then
    echo "error: the TypeScript server did not start:" >&2
    cat "$tslog" >&2
    exit 1
  fi
  sleep 0.1
done
if [ -z "$tsurl" ]; then
  echo "error: the TypeScript server did not say where it listens:" >&2
  cat "$tslog" >&2
  exit 1
fi

status=0

# The generated Python client against both servers.
echo "python client -> typescript handlers ($tsurl)"
API_URL="$tsurl" uv run --frozen python -m unittest --quiet test_client || status=$?
echo "python client -> generated fastapi application ($url)"
API_URL="$url" uv run --frozen python -m unittest --quiet test_client || status=$?

# The TypeScript client and the conformance tests against FastAPI.
cd "$root"
FASTAPI_URL="$url" deno test --allow-read --allow-net --allow-env=FASTAPI_URL \
  e2e_tests/python/against_fastapi.ts "$@" || status=$?

if [ "$status" -ne 0 ]; then
  echo "--- application log ---" >&2
  cat "$log" >&2
fi
exit "$status"
