#!/usr/bin/env bash
#
# Type-check the integrations against the frameworks' own type definitions.
#
# Installs Next.js, SvelteKit, Astro, Hono and h3 at exact versions in a
# throwaway project, next to the library sources installed as a package,
# and runs the TypeScript compiler over e2e_tests/framework-types/check.ts.
#
# Next.js, SvelteKit and Astro are not run by any test: this is what shows
# that the handlers createApiHandlers() returns are handlers of those
# frameworks. To follow a release of one of those three, change its version
# below; Hono and h3 are named in scripts/bun-package.ts. Then write the
# lockfile again: UPDATE_LOCK=1 ./scripts/check-framework-types.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

source "$root/scripts/pinned"
require_pinned bun

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

pkg="$work/node_modules/@dgellow/typed-endpoints"
mkdir -p "$pkg"
cp -R "$root/src" "$pkg/src"
find "$pkg/src" \( -name '*_test.ts' -o -name '*.test.ts' \) -type f -delete
find "$pkg/src" \( -name fixtures -o -name __snapshots__ \) -type d -prune -exec rm -rf {} +
bun "$root/scripts/bun-package.ts" "$root/deno.json" "$pkg/package.json" "$work/base.json"

cd "$work"
cat > package.json <<'JSON'
{
  "name": "framework-types",
  "private": true,
  "type": "module",
  "dependencies": {
    "next": "16.4.6",
    "@sveltejs/kit": "3.2.0",
    "astro": "7.4.12",
    "typescript": "6.0.3",
    "@types/node": "22.20.5"
  }
}
JSON
# Added to those: the library's own npm dependencies, at the versions
# deno.lock names, and Hono and h3, at the versions the Bun tests run them
# with. scripts/bun-package.ts is the one place that names them.
bun -e '
  const base = JSON.parse(await Bun.file("base.json").text());
  const pkg = JSON.parse(await Bun.file("package.json").text());
  Object.assign(pkg.dependencies, base.dependencies);
  await Bun.write("package.json", JSON.stringify(pkg, null, 2));
'
rm base.json

cat > tsconfig.json <<'JSON'
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "files": ["check.ts"]
}
JSON
cp "$root/e2e_tests/framework-types/check.ts" check.ts

# e2e_tests/framework-types/bun.lock fixes every package that is
# installed, also the ones the frameworks depend on. An install that would
# not match it fails. UPDATE_LOCK=1 writes the lockfile again.
lock="$root/e2e_tests/framework-types/bun.lock"
if [ "${UPDATE_LOCK:-}" = 1 ]; then
  bun install --silent --ignore-scripts
  cp bun.lock "$lock"
else
  cp "$lock" bun.lock
  # Quiet when it fits the lockfile; Bun's own words when it does not.
  if ! output="$(bun install --ignore-scripts --frozen-lockfile 2>&1)"; then
    printf '%s\n' "$output" >&2
    echo "to write the lockfile again: UPDATE_LOCK=1 ./scripts/check-framework-types" >&2
    exit 1
  fi
fi
bunx tsc -p tsconfig.json
echo "framework types: ok"
